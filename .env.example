# Database
# Local SQLite development:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL (switch provider to "postgresql" in schema.prisma):
# DATABASE_URL="postgresql://username:password@hostname:5432/bookhand?sslmode=require"

# Application URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email Configuration (Resend or SMTP)
# RESEND_API_KEY="re_123456789"
# EMAIL_FROM="BookHand <noreply@bookhand.com>"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="smtp-username"
# SMTP_PASS="smtp-password"

# Cloud Image Storage (Cloudinary or S3)
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"
# AWS_REGION="ap-southeast-1"
# AWS_S3_BUCKET="bookhand-uploads"

# Payment Gateways (Bangladesh & International)
# BKASH_APP_KEY="your-bkash-app-key"
# BKASH_APP_SECRET="your-bkash-app-secret"
# BKASH_USERNAME="your-bkash-username"
# BKASH_PASSWORD="your-bkash-password"
# BKASH_IS_SANDBOX="true"
# SSLCOMMERZ_STORE_ID="your-store-id"
# SSLCOMMERZ_STORE_PASSWD="your-store-password"
# SSLCOMMERZ_IS_SANDBOX="true"
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Google OAuth
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"
